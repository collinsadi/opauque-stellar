{
  "name": "opaque-stellar-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "prebuild": "tsx ../scripts/prepare-frontend-artifacts.ts",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "vite preview --host 0.0.0.0 --port ${PORT:-4173}",
    "test": "vitest run",
    "test:mutation": "stryker run",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test",
    "test:e2e:chromium": "npx playwright test --project=chromium",
    "test:e2e:firefox": "npx playwright test --project=firefox",
    "test:e2e:webkit": "npx playwright test --project=webkit",
    "test:e2e:update": "npx playwright test --project=chromium --update-snapshots",
    "test:cross-browser": "bash ../scripts/cross-browser-test.sh",
    "smoke:payments": "tsx scripts/smoke-private-payment.ts",
    "smoke:reputation": "tsx scripts/smoke-reputation-v2.ts",
    "smoke:realset": "tsx scripts/smoke-reputation-realset.ts",
    "publish:root": "tsx scripts/publish-reputation-root.ts",
    "verify:deployment": "tsx ../scripts/verify-deployment-manifest.ts",
    "smoke:pool": "tsx scripts/smoke-pool.ts",
    "smoke:pool:relayer": "tsx scripts/smoke-relayed-pool.ts",
    "test:a11y": "npx playwright test e2e/a11y.spec.ts --project=chromium"
  },
  "dependencies": {
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@opaquecash/stellar": "file:../sdk",
    "@stellar/freighter-api": "6.0.1",
    "@stellar/stellar-sdk": "15.1.0",
    "buffer": "^6.0.3",
    "circomlibjs": "^0.1.7",
    "driver.js": "^1.4.0",
    "framer-motion": "^12.34.2",
    "html5-qrcode": "^2.3.8",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "process": "^0.11.10",
    "qrcode.react": "4.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-icons": "5.6.0",
    "react-router-dom": "7.13.0",
    "snarkjs": "0.7.6",
    "tweetnacl": "1.0.3",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "overrides": {
    "axios": "1.16.1",
    "elliptic": "6.6.1",
    "underscore": "1.13.8",
    "ws": "8.20.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/vite": "^4.2.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "rollup-plugin-visualizer": "^5.12.0",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.22.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^4.1.7",
    "@stryker-mutator/core": "^8.6.1"
  }
}
